# Public site URL
# Set this to the primary production domain in Vercel.
NEXT_PUBLIC_SITE_URL="https://www.codetelemetrylab.me"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
API_URL=""
my_secret_key=""
my_publishable_key=""
CRON_SECRET="replace-with-a-long-random-secret"
SUPABASE_PROJECT_REF=""
WIKIMEDIA_USER_AGENT="CodeTelemetryLabsBlogCoverBot/1.0 (https://www.codetelemetrylab.me)"

# Auth.js / admin
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@codetelemetrylabs.com"
ADMIN_PASSWORD="admin1234"

# Contact notifications / outbound email
RESEND_API_KEY=""
CONTACT_NOTIFICATION_FROM="CodeTelemetryLab <contact@codetelemetrylab.me>"
CONTACT_NOTIFICATION_TO="contact@codetelemetrylab.me"
EMAIL_FROM="contact@codetelemetrylab.me"

# Daily lead discovery (admin Leads -> Prospects). See docs/LEAD-DISCOVERY.md.
# Required: Groq key for qualification and drafts (free key at console.groq.com).
GROQ_API_KEY=""
# Optional: override the model (default llama-3.3-70b-versatile).
GROQ_MODEL=""
# Optional: extra news-search sources. Discovery works without them (public feeds + Hacker News).
TAVILY_API_KEY=""
SERPER_API_KEY=""

# Google Search Console (Admin > Search Console). OAuth "Web application" client from Google Cloud.
# Authorized redirect URI: https://www.codetelemetrylab.me/api/admin/search-console/callback (and http://localhost:3000/... for local).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: force one redirect URI (otherwise the request origin is used).
GOOGLE_OAUTH_REDIRECT_URI=""
# Encrypts the stored Google refresh token (32+ random characters). Falls back to NEXTAUTH_SECRET when empty.
SEARCH_CONSOLE_TOKEN_KEY=""

# Admin AI assistant (Admin > AI Assistant). Groq key; falls back to GROQ_API_KEY.
GROQ_AI_LAYER_KEY=""
# Optional: model override (default openai/gpt-oss-120b, then llama-3.3-70b-versatile).
GROQ_AI_MODEL=""

# Mobile lead app notifications
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
MOBILE_TOKEN_SECRET=""

# Legacy PostgreSQL fallback / Prisma tooling
DATABASE_URL="postgresql://postgres:password@localhost:5432/codetelemetrylabs"
